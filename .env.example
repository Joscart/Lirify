# ---------------------------------------------------------------------------
# Lirify — LOCAL DEVELOPMENT environment.
#
# Every value is local-only and intentionally NOT secret: the stack runs with
# limits disabled and a throwaway database. Production values live in GitHub
# Actions secrets -> Secret Manager (see docs/DEPLOYMENT.md).
#
# MongoDB is configured with connection STRINGS only. MONGODB_URI is the single
# source of truth: db-init parses it to create the application database/user, and
# python-backend connects with it verbatim. Paste an Atlas string here to point
# the stack at Atlas instead of the container.
# ---------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=lirify

# --- public cloud metadata (safe to share) ----------------------------------
GCP_PROJECT_ID=lirify-514907
GCP_REGION=us-central1
ARTIFACT_REGISTRY=us-central1-docker.pkg.dev/lirify-514907/lirify

WEB_DOMAIN=lirify.joscart.win
INDEX_DOMAIN=index.joscart.win
LIRIFY_DOMAIN=lirify.joscart.win
LIRIFY_INDEX_DOMAIN=index.joscart.win
LIRIFY_EMAIL=admin@lirify.joscart.win

# --- MongoDB ---------------------------------------------------------------
# Container bootstrap credentials (required by the mongo image itself).
MONGO_ROOT_USER=lirify_root
MONGO_ROOT_PASSWORD=change-me-dev-only
# Root connection string used only by db-init.
MONGO_ROOT_URI=mongodb://lirify_root:change-me-dev-only@mongo:27017/admin
# Application connection string: db-init creates this user/database, the API and
# any Mongoose client use it unchanged.
MONGODB_URI=mongodb://lirify:change-me-dev-only@mongo:27017/lirify?authSource=lirify

# --- Qdrant (local container; no API key) ----------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=lirify_lyrics
QDRANT_VECTOR_SIZE=256

# --- bot ingestion (dev bearer; unlimited locally) -------------------------
BOT_INGEST_API_KEY=dev-bot-key
BOT_RATE_LIMIT=0
BOT_RATE_WINDOW_SECONDS=3600
BOT_CHECK_RETRY_MIN_SECONDS=900
BOT_CHECK_RETRY_MAX_SECONDS=7200

# --- public surface: no limits on the dev stack ----------------------------
PUBLIC_RATE_LIMIT_PER_MINUTE=0

# --- capacity: unlimited locally (production defaults to 1000) -------------
MAX_INDEXED_SONGS=-1
MAX_JOB_ATTEMPTS=8
RETRY_INTERVAL_SECONDS=300

# --- client wiring for the skill / scripts --------------------------------
LIRIFY_BOT_API_URL=http://127.0.0.1:8000
LIRIFY_CLOUD_API_URL=https://lirify-api-oao7gs5n7q-uc.a.run.app
LIRIFY_BOT_TIMEOUT=900

# How often a running instance checks the shared index revision (0 = never).
# Local indexing writes to the same Atlas/Qdrant, so the cloud replica reloads
# within this window; scripts/sync_with_cloud.py reload forces it immediately.
INDEX_REFRESH_SECONDS=60
# Per-request revision check window (Cloud Run freezes background tasks between
# requests, so this is what makes a local batch visible to the cloud).
INDEX_CHECK_SECONDS=10
