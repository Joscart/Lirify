# Lirify deployment configuration. Copy to `.env` for docker compose.

# --- public edge (docker compose --profile public) -------------------------
LIRIFY_DOMAIN=lirify.joscart.win
LIRIFY_INDEX_DOMAIN=index.liirify.joscart.win
LIRIFY_EMAIL=admin@lirify.joscart.win

# --- shared state (required in production; omitted = in-memory dev store) --
# MongoDB Atlas M0 connection string, e.g.
# mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=lirify

# --- vectors (required in production; omitted = in-process matrix) --------
QDRANT_URL=https://xxxxx.eu-central.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=lirify_lyrics
QDRANT_VECTOR_SIZE=256

# --- bot ingestion API ----------------------------------------------------
BOT_INGEST_API_KEY=
BOT_RATE_LIMIT=30
BOT_RATE_WINDOW_SECONDS=3600

# --- workers / capacity ---------------------------------------------------
MAX_JOB_ATTEMPTS=8
RETRY_INTERVAL_SECONDS=300
# Cloud Run free tier gives the container 512 MiB; refuse to commit beyond this.
MAX_INDEXED_SONGS=1500

# --- client wiring (astro SSR / go-webui) ---------------------------------
# python-backend Cloud Run URL; the astro server talks gRPC to it.
PYTHON_BACKEND_URL=https://lirify-api-xxxxx-uc.a.run.app
GRPC_TARGET=lirify-api-xxxxx-uc.a.run.app:443
