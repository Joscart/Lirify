---
import Icon from "./Icon.astro";
---

<footer class="player-bar" id="player-bar" aria-label="Player">
  <div class="mobile-progress" id="mobile-seek" role="slider" tabindex="0" aria-label="Seek" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-valuetext="0:00 of 0:00"><i id="mobile-progress-fill"></i></div>

  <div class="player-track">
    <div class="player-art" id="pb-art" role="button" tabindex="0" aria-label="Open the full player">
      <img id="pb-art-img" alt="" hidden />
      <div class="art-fallback" id="pb-art-fallback">
        <Icon name="music" size={22} />
      </div>
    </div>
    <div class="player-meta">
      <div class="title" id="pb-title" role="button" tabindex="0">Nothing playing</div>
      <div class="artist" id="pb-artist">Pick a track to start</div>
      <span class="player-badge" id="pb-badge" data-state="plain">idle</span>
    </div>
    <div class="player-track-actions">
      <button class="icon-btn tiny" id="btn-like" aria-label="Like this track" aria-pressed="false">
        <Icon name="heart" size={16} />
      </button>
      <button class="icon-btn tiny" id="btn-more" aria-label="More options for this track">
        <Icon name="more" size={16} />
      </button>
    </div>
  </div>

  <div class="transport">
    <div class="transport-buttons">
      <button class="icon-btn optional" id="btn-shuffle" aria-label="Shuffle" aria-pressed="false">
        <Icon name="shuffle" size={16} />
      </button>
      <button class="icon-btn" id="btn-prev" aria-label="Previous track">
        <Icon name="skip-back" size={19} />
      </button>
      <button class="btn-play" id="btn-play" aria-label="Play" data-loading="false" data-tip="Play">
        <svg class="icon-play" width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M8 5.15v13.7a1 1 0 0 0 1.53.85l10.6-6.85a1 1 0 0 0 0-1.7L9.53 4.3A1 1 0 0 0 8 5.15Z"></path>
        </svg>
        <svg class="icon-pause" width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" hidden>
          <rect x="7" y="4.5" width="3.6" height="15" rx="1.2"></rect>
          <rect x="13.4" y="4.5" width="3.6" height="15" rx="1.2"></rect>
        </svg>
      </button>
      <button class="icon-btn" id="btn-next" aria-label="Next track">
        <Icon name="skip-forward" size={19} />
      </button>
      <button class="icon-btn optional" id="btn-repeat" aria-label="Repeat off" aria-pressed="false">
        <Icon name="repeat" size={16} />
      </button>
    </div>

    <div class="seek" id="seek" role="slider" tabindex="0" aria-label="Seek" aria-valuemin="0" aria-valuenow="0" aria-valuemax="100">
      <span class="time is-current" id="seek-current">0:00</span>
      <div class="wave" id="seek-wave">
        <div class="wave-bars" id="wave-base"></div>
        <div class="wave-bars wave-bars--played" id="wave-played"></div>
        <div class="wave-knob" id="seek-knob"></div>
        <div class="wave-tooltip" id="seek-tooltip">0:00</div>
      </div>
      <span class="time" id="seek-duration">0:00</span>
    </div>
  </div>

  <div class="player-actions">
    <div class="volume-wrap">
      <button class="icon-btn tiny" id="btn-mute" aria-label="Mute">
        <Icon name="volume-high" size={17} />
      </button>
      <div class="volume" id="volume" role="slider" tabindex="0" aria-label="Volume" aria-valuemin="0" aria-valuemax="100" aria-valuenow="80">
        <div class="volume-rail"><div class="volume-fill" id="volume-fill" style="--v: 80%"></div></div>
      </div>
    </div>
    <button class="icon-btn desktop-only" id="btn-video" aria-label="Watch the music video" data-tip="Video">
      <Icon name="video" />
    </button>
    <button class="icon-btn" id="btn-theater" aria-label="Open theater" data-tip="Theater">
      <Icon name="theater" />
    </button>
    <button class="icon-btn" id="btn-lyrics" aria-label="Toggle lyrics" aria-pressed="false" data-tip="Lyrics">
      <Icon name="mic" />
    </button>
    <button class="icon-btn" id="btn-queue" aria-label="Toggle queue" aria-pressed="false" data-tip="Queue">
      <Icon name="queue" />
    </button>
    <button class="icon-btn desktop-only" id="btn-mini" aria-label="Mini player" aria-pressed="false" data-tip="Mini player">
      <Icon name="mini" />
    </button>
  </div>
</footer>
