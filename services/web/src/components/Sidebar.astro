---
import Icon from "./Icon.astro";
---

<aside class="sidebar" id="sidebar" aria-label="Primary navigation">
  <a class="brand" href="#/" aria-label="Lirify home">
    <span class="brand-mark" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none">
        <path
          d="M8 17.5V6.4l9-1.9v11.1"
          stroke="currentColor"
          stroke-width="2.1"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
        <circle cx="5.4" cy="17.7" r="2.5" fill="currentColor"></circle>
        <circle cx="14.4" cy="15.7" r="2.5" fill="currentColor"></circle>
      </svg>
    </span>
    <span class="brand-name">lirify<span>.</span></span>
    <span class="brand-tag">lyrics first</span>
  </a>

  <nav class="nav" aria-label="Browse">
    <a class="nav-item is-active" href="#/" data-nav="home">
      <Icon name="home" />
      <span>Home</span>
    </a>
    <a class="nav-item" href="#/search" data-nav="search">
      <Icon name="search" />
      <span>Search</span>
    </a>
    <a class="nav-item" href="#/library" data-nav="library">
      <Icon name="library" />
      <span>Your library</span>
    </a>
    <a class="nav-item" href="#/videos" data-nav="videos">
      <Icon name="video" />
      <span>Music videos</span>
    </a>
  </nav>

  <div class="sidebar-section">
    <div class="sidebar-heading">
      <span>Playlists</span>
      <a class="icon-btn tiny" href="#/library/playlists" aria-label="All playlists">
        <Icon name="plus" size={15} />
      </a>
    </div>
    <ul class="sidebar-list" id="sidebar-playlists">
      {Array.from({ length: 6 }).map(() => (
        <li class="sidebar-playlist">
          <span class="mosaic skeleton" style="width:34px;height:34px;border-radius:7px"></span>
          <span class="meta">
            <b class="skeleton" style="width:118px;height:9px;display:block;margin:3px 0 6px"></b>
            <span class="skeleton" style="width:64px;height:7px;display:block"></span>
          </span>
        </li>
      ))}
    </ul>
  </div>

  <div class="sidebar-foot">
    <div class="index-card">
      <div class="ring" id="index-ring" style="--p: 0"><span id="index-score">0</span></div>
      <div class="meta">
        <b id="index-title">Reading index…</b>
        <span id="index-meta">Loading library</span>
        <a class="index-link" id="indexer-link" href="http://localhost:8080" target="_blank" rel="noreferrer">
          Indexer <Icon name="external" size={11} />
        </a>
      </div>
    </div>
  </div>
</aside>

<button class="scrim" id="scrim" aria-label="Close navigation"></button>
