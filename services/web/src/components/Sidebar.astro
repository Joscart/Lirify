---
import Icon from "./Icon.astro";
import { LANGUAGE_COOKIE, resolveLanguage, translator } from "../lib/locale";

const lang = resolveLanguage(Astro.url, Astro.cookies.get(LANGUAGE_COOKIE)?.value);
const text = translator(lang);
---

<aside class="sidebar" id="sidebar" aria-label={text("Navegación principal", "Primary navigation")}>
  <a class="brand" href="#/" aria-label={text("Inicio de UPSpotify", "UPSpotify home")}>
    <span class="brand-mark" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none">
        <path
          d="M8 17.5V6.4l9-1.9v11.1"
          stroke="currentColor"
          stroke-width="2.1"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
        <circle cx="5.4" cy="17.7" r="2.5" fill="currentColor"></circle>
        <circle cx="14.4" cy="15.7" r="2.5" fill="currentColor"></circle>
      </svg>
    </span>
    <span class="brand-name">UP<span>Spotify</span></span>
  </a>

  <nav class="nav" aria-label={text("Explorar música", "Browse music")}>
    <a class="nav-item is-active" href="#/search" data-nav="search" aria-current="page">
      <Icon name="search" />
      <span>{text("Buscar", "Search")}</span>
    </a>
    <a class="nav-item" href="#/discover" data-nav="home">
      <Icon name="compass" />
      <span>{text("Descubrir", "Discover")}</span>
    </a>
    <a class="nav-item" href="#/library" data-nav="library">
      <Icon name="library" />
      <span>{text("Biblioteca", "Library")}</span>
    </a>
    <a class="nav-item" href="#/videos" data-nav="videos">
      <Icon name="video" />
      <span>{text("Videos musicales", "Music videos")}</span>
    </a>
    <a class="nav-item" href="#/import" data-nav="import">
      <Icon name="plus" />
      <span>{text("Agregar canciones", "Add songs")}</span>
    </a>
  </nav>

  <div class="sidebar-section">
    <div class="sidebar-heading">
      <span>{text("Listas", "Playlists")}</span>
      <a class="icon-btn tiny" href="#/library/playlists" aria-label={text("Todas las listas", "All playlists")}>
        <Icon name="plus" size={15} />
      </a>
    </div>
    <ul class="sidebar-list" id="sidebar-playlists">
      {Array.from({ length: 6 }).map(() => (
        <li class="sidebar-playlist">
          <span class="mosaic skeleton" style="width:34px;height:34px;border-radius:7px"></span>
          <span class="meta">
            <b class="skeleton" style="width:118px;height:9px;display:block;margin:3px 0 6px"></b>
            <span class="skeleton" style="width:64px;height:7px;display:block"></span>
          </span>
        </li>
      ))}
    </ul>
  </div>

  <div class="sidebar-foot">
    <div class="index-card">
      <div class="meta">
        <b id="index-title">{text("Cargando catálogo…", "Loading catalogue…")}</b>
        <a class="index-link" id="indexer-link" href="#/library">
          {text("Ver catálogo", "View catalogue")}
        </a>
      </div>
    </div>
  </div>
</aside>

<button class="scrim" id="scrim" tabindex="-1" aria-label={text("Cerrar navegación", "Close navigation")}></button>
