---
import { ICONS, SOLID } from "../lib/icons";

interface Props {
  name: string;
  size?: number;
  class?: string;
  stroke?: number;
  label?: string;
}

const { name, size = 20, class: className = "", stroke = 1.8, label } = Astro.props;
const body = ICONS[name] ?? ICONS.circle;
const solid = SOLID.has(name);
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={solid ? "currentColor" : "none"}
  stroke="currentColor"
  stroke-width={solid ? 0 : stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  set:html={body}
/>
