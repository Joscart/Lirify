---
import Icon from "./Icon.astro";
---

<header class="topbar" id="topbar">
  <button class="icon-btn mobile-only" id="btn-menu" aria-label="Open navigation" aria-expanded="false" aria-controls="sidebar">
    <Icon name="menu" />
  </button>

  <div class="history-nav">
    <button class="icon-btn round" id="btn-back" aria-label="Go back" data-tip="Back">
      <Icon name="arrow-left" size={17} />
    </button>
    <button class="icon-btn round" id="btn-forward" aria-label="Go forward" data-tip="Forward">
      <Icon name="arrow-right" size={17} />
    </button>
  </div>

  <form class="searchbar" id="search-form" role="search" autocomplete="off">
    <Icon name="search" />
    <input
      id="search-input"
      type="search"
      name="q"
      placeholder="Search songs, artists or lyrics"
      aria-label="Search songs, artists or lyrics"
      spellcheck="false"
      enterkeyhint="search"
    />
    <kbd aria-hidden="true">/</kbd>
    <button class="icon-btn tiny" id="search-clear" type="button" aria-label="Clear search" hidden>
      <Icon name="close" size={15} />
    </button>
    <button class="sr-only" type="submit">Search</button>
    <div class="search-suggest" id="search-suggest" hidden></div>
  </form>

  <div class="topbar-actions">
    <button
      class="icon-btn desktop-only"
      id="btn-adaptive"
      aria-label="Adapt colours to the cover"
      aria-pressed="true"
      data-tip="Adaptive colour"
    >
      <Icon name="palette" />
    </button>
    <button class="icon-btn desktop-only" id="btn-queue-top" aria-label="Open queue" aria-pressed="false" data-tip="Queue">
      <Icon name="queue" />
    </button>
    <button class="icon-btn" id="btn-lyrics-top" aria-label="Open lyrics" aria-pressed="false" data-tip="Lyrics">
      <Icon name="mic" />
    </button>
    <a class="avatar" href="#/library" id="btn-profile" aria-label="Your indexed library" data-tip="Your library">L</a>
  </div>
</header>
