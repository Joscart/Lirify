---
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/shell.css";
import "../styles/cards.css";
import "../styles/panels.css";
import "../styles/course.css";
import "../styles/studio.css";
import { LANGUAGE_COOKIE, resolveLanguage, translator } from "../lib/locale";

const lang = resolveLanguage(Astro.url, Astro.cookies.get(LANGUAGE_COOKIE)?.value);
const text = translator(lang);

interface Props {
  title?: string;
  description?: string;
}

const {
  title = text("UPSpotify · Busca canciones por su letra", "UPSpotify · Find songs by lyrics"),
  description = text("Busca por letra y descubre canciones similares.", "Find songs by lyrics and discover similar tracks."),
} = Astro.props;

const apiBase = (import.meta.env.PUBLIC_API_BASE as string | undefined) || "";
---

<!doctype html>
<html lang={lang} data-accent="#ffc375">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#171b29" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <title>{title}</title>

    <link rel="canonical" href="https://lirify.joscart.win/" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://lirify.joscart.win/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%23171b29'/%3E%3Cpath d='M11 23V9.5l12-2.5v13' fill='none' stroke='%23ffc375' stroke-width='2.4' stroke-linecap='round'/%3E%3Ccircle cx='8.2' cy='23.2' r='3' fill='%23ffc375'/%3E%3Ccircle cx='20.2' cy='20.2' r='3' fill='%23ffc375'/%3E%3C/svg%3E" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://i.ytimg.com" />
    <link rel="preconnect" href="https://www.youtube-nocookie.com" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300..700&family=IBM+Plex+Mono:wght@400;500&family=Instrument+Serif&family=Outfit:wght@300..800&display=swap"
    />

    <script is:inline define:vars={{ apiBase }}>
      try {
        const saved = localStorage.getItem("lirify-theme");
        document.documentElement.dataset.theme =
          saved === "dark" || saved === "light"
            ? saved
            : matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
      } catch {}
      window.__LIRIFY_API__ = apiBase || undefined;
    </script>
  </head>
  <body>
    <a class="skip-link" href="#view">{text("Ir al contenido", "Skip to content")}</a>
    <slot />

    <audio id="audio" preload="auto" playsinline class="sr-only"></audio>
    <div id="yt-audio" aria-hidden="true"></div>
    <div class="toasts" id="toasts" aria-live="polite" aria-atomic="false"></div>

    <noscript>
      <div style="padding:48px;text-align:center;font-family:sans-serif">
        {text("Activa JavaScript para usar el reproductor de UPSpotify.", "Enable JavaScript to use the UPSpotify player.")}
      </div>
    </noscript>
  </body>
</html>
